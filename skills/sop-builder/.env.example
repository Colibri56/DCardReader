# SOP Builder - OPTIONAL connector placeholders.
#
# NONE of these is required. The skill works fully on the universal quartet
# (local file -> Google Sheets -> Gmail -> Telegram) with an EMPTY .env.
# Fill in only the connectors you actually want, then copy this file to ".env".
# Never commit the real .env - it is gitignored.

# --- Telegram (optional): approval-gate + proactive "found a repeat" prompts ---
# Without these, notify.py simply prints the message so chat-based approval works.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Task boards (optional): turn the final checklist into onboarding tasks ---
# Without any of these, the checklist stays inside the SOP / a local file.
MONDAY_API_KEY=
TRELLO_API_KEY=
TRELLO_TOKEN=
ASANA_ACCESS_TOKEN=
CLICKUP_API_KEY=

# --- SOP store (optional): a tidy procedures library ---
# Without these, the SOP is saved as a local Markdown file (and optionally Sheets).
NOTION_TOKEN=

# Google (Gmail / Docs / Sheets / Drive) is usually reached through the connection
# already present in your Claude Code session (an MCP server or an OAuth login),
# not through a key here - so there is intentionally no required Google key.
